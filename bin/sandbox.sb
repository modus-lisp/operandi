;; agent.sb — absolute paths only; ~ does not expand inside profiles
(version 1)
(deny default)

;; --- bare minimum to exec anything ---
(allow process-exec process-fork)          ; launching + children
(allow file-map-executable)                ; mmap binaries as code — without this: SIGKILL
(allow signal (target self))               ; runtime raising signals to itself
(allow sysctl-read)                        ; every runtime wants hw.ncpu etc.

(allow file-read-data file-read-metadata (path "/" "/Users" "/Users/vinnyfiano"))
(allow file-read-data file-read-metadata (subpath "/usr" "/opt" "/Users/vinnyfiano/.cache/common-lisp"))

;; realpath()/getcwd() stat every component on the way up, so each subpath
;; grant below needs metadata-only access on all of its ancestors — one missing
;; link (e.g. ~/workspace) and SBCL's PROBE-FILE returns NIL and LOAD crashes.
;; The profile language is TinyScheme, so walk up to "/" instead of listing.
(define (parent-dir p)
  (let loop ((i (- (string-length p) 1)))
    (cond ((<= i 0) "/")
          ((char=? (string-ref p i) #\/) (substring p 0 i))
          (else (loop (- i 1))))))
(define (allow-ancestor-metadata p)
  (if (> (string-length p) 1)
      (begin (allow file-read-metadata (literal p))
             (allow-ancestor-metadata (parent-dir p)))))

;; The rest of the OS, read-only: /bin and /sbin for the coreutils the agent's
;; Bash tool leans on (ls, cat, sleep…), /System and /Library for the dylibs,
;; frameworks and Command Line Tools that anything non-trivial (perl, python3,
;; node, git) links against, /private/var/select for /bin/sh's shell choice.
(allow file-read-data file-read-metadata
  (subpath "/bin" "/sbin" "/System" "/Library" "/private/var/select"))
(allow file-read* (literal "/dev/random" "/dev/urandom"))
;; Scratch space (the xcrun shims behind /usr/bin/git etc. also cache here),
;; and the user's git identity so commits inside the project work.
(allow-ancestor-metadata "/private/tmp")
(allow file-read* file-write* (subpath "/private/tmp"))
;; The per-user temp/cache dirs (confstr DARWIN_USER_TEMP_DIR — resolved via
;; the dirhelper service); without them git/xcrun/python warn on every call.
(allow mach-lookup (global-name "com.apple.bsd.dirhelper"))
(allow-ancestor-metadata "/private/var/folders/9m/1ylshs2s2y14754pxfxhxf4h0000gp/T")
(allow-ancestor-metadata "/private/var/folders/9m/1ylshs2s2y14754pxfxhxf4h0000gp/C")
(allow file-read* file-write* (subpath "/private/var/folders/9m/1ylshs2s2y14754pxfxhxf4h0000gp/T"
                                       "/private/var/folders/9m/1ylshs2s2y14754pxfxhxf4h0000gp/C"))
(allow file-read* (literal "/Users/vinnyfiano/.gitconfig" "/Users/vinnyfiano/.gitignore_global")
                  (subpath "/Users/vinnyfiano/.config/git"))

;; The agent's own world — writable, since it self-modifies
(allow-ancestor-metadata "/Users/vinnyfiano/workspace/modus-lisp")
(allow file-read* file-write* (subpath "/Users/vinnyfiano/workspace/modus-lisp"))

;; The caller's project — the launcher passes it as -D CWD=<resolved cwd>.
;; Writable like modus-lisp, so the agent can work on whatever you ran it from.
(allow-ancestor-metadata (param "CWD"))
(allow file-read* file-write* (subpath (param "CWD")))

;; Narrow exceptions as needed, e.g.:
(allow file-read* file-write* (subpath "/Users/vinnyfiano/.operandi"))
(allow file-read* file-write* (subpath "/dev/null"))

;; The terminal: stdin/stdout are inherited fds, but linedit's tcsetattr()
;; (raw mode) is an ioctl that's checked per call, and it also opens /dev/tty
(allow file-read* file-write* file-ioctl
  (literal "/dev/tty")
  (regex #"^/dev/ttys[0-9]+$"))

;; Local timezone, so session-log timestamps aren't UTC
(allow file-read* (literal "/private/etc/localtime") (subpath "/private/var/db/timezone"))

;; The clipboard, so Ctrl-V in the TUI can pull in a pasted image
;; (pngpaste needs only the pasteboard service — osascript would drag in
;; LaunchServices and half a dozen more)
(allow mach-lookup (global-name "com.apple.pasteboard.1"
                                ;; read-only LaunchServices type map, for the
                                ;; TIFF->PNG conversion of a screenshot
                                "com.apple.lsd.mapdb"))

;; Don't let it drive Finder/Terminal/browsers via AppleScript
(deny appleevent-send)

;; DNS: getaddrinfo -> libinfo -> mDNSResponder (mach, not sockets)
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.dnssd.service"))

;; Resolver config — note /private: /etc is a symlink,
;; and the sandbox matches the resolved path
(allow file-read-data (subpath "/private/etc"))
;; ...but getaddrinfo lstat()s the /etc and /var symlinks themselves on the
;; way to /etc/hosts and /var/run/resolv.conf, and those are checked under
;; the unresolved name. Without this every lookup is NS-HOST-NOT-FOUND.
(allow file-read-metadata (literal "/etc" "/var" "/tmp"))

;; Network: anything public, but nothing on this machine — except the local
;; llama server (src/llm.lisp *llm-url*). Later rules win, so the order
;; matters. NB: the profile language only knows "*" and "localhost" as hosts,
;; so LAN/private ranges (10/8, 192.168/16, ...) can't be excluded here;
;; that would take a pf rule outside the sandbox.
(allow network-outbound (remote tcp "*:*"))
(deny  network-outbound (remote tcp "localhost:*"))
(allow network-outbound (remote tcp "localhost:8081"))

(allow network-outbound (literal "/private/var/run/mDNSResponder"))

;; Local dev server: without network-bind, listen() is EPERM, so the agent
;; can't smoke-test a web page with `python3 -m http.server` or a node server.
;; Loopback only — this does not expose anything off-machine.
(allow network-bind   (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
