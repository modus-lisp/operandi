#!/usr/bin/env bash
# Fast launcher for operandi.
#
# SBCL's own startup is ~50ms, but loading operandi from source every run is
# slow — mostly an ASDF source-registry scan (if your ~/.config points a :tree
# at a big directory) plus Quicklisp loading dexador's dependency closure. So
# instead we dump a CORE image with operandi baked in, and launch
# from it with the init files skipped: ~20ms to a ready agent.
#
# The core is rebuilt automatically on first run and whenever a source file is
# newer than it. Usage mirrors bin/operandi.lisp:
#   bin/operandi "task description"
#   bin/operandi --repl
#   bin/operandi --openrouter deepseek/deepseek-v4-flash "task"
set -euo pipefail

# Follow symlinks to find the real script, so ROOT is the repo even when this
# is invoked through a link on PATH (e.g. ~/.local/bin/operandi-no-sandbox).
SELF="$0"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *)  SELF="$(dirname "$SELF")/$TARGET" ;;
  esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"
CORE="$ROOT/operandi.core"
SBCL="${OPERANDI_SBCL:-sbcl}"

needs_build() {
  [ ! -f "$CORE" ] && return 0
  # any source or the .asd newer than the core → rebuild; that includes
  # illatio's, which the core also holds (--illatio), when it sits beside us
  [ -n "$(find "$ROOT/src" "$ROOT/operandi.asd" "$ROOT/bin/operandi.lisp" \
            "$ROOT/../illatio/src" "$ROOT/../illatio/illatio.asd" \
            -newer "$CORE" 2>/dev/null | head -1)" ]
}

if needs_build; then
  echo "operandi: building core image (one-time, ~20s)…" >&2
  # The build pays the full source scan + compile ONCE. It uses the normal init
  # files so Quicklisp is found; the resulting core needs none of that at run.
  "$SBCL" --non-interactive \
    --eval '(require :asdf)' \
    --eval "(let ((q (merge-pathnames \"quicklisp/setup.lisp\" (user-homedir-pathname)))) (when (probe-file q) (load q)))" \
    --eval '(funcall (read-from-string "ql:quickload") :operandi :silent t)' \
    --eval "(save-lisp-and-die \"$CORE\")" >/dev/null
fi

# A sandboxed launcher can't rebuild (no ~/quicklisp, no fasl cache), so it
# runs us unsandboxed with this set to do the freshness check first.
[ -n "${OPERANDI_BUILD_ONLY:-}" ] && exit 0

# Launch from the core. --no-userinit/--no-sysinit skips the init files (and
# thus the whole-home ASDF tree scan); operandi is already in the image, so
# bin/operandi.lisp's load is a no-op and only the CLI dispatch runs.
# The heap is sized for --illatio, whose weights live in it (reserved, not used, otherwise).
exec "$SBCL" --core "$CORE" --dynamic-space-size "${OPERANDI_HEAP_MB:-16384}" --noinform --no-userinit --no-sysinit --non-interactive \
  --load "$ROOT/bin/operandi.lisp" -- "$@"
